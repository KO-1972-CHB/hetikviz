# Default server-side AI provider. Choose openai to use the optional OpenAI settings.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Optional OpenAI provider.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Shared server-side teacher password (at least 16 characters).
TEACHER_PASSWORD=

# Writable persistent directory for published quizzes on the Express server.
PUBLISHED_QUIZ_DIR=

# Redis REST connection for Vercel. Use one complete read/write pair.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Alternative names when connecting to Upstash manually.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Set a distinct stable prefix if sharing Redis across projects.
QUIZ_STORE_PREFIX=
